{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/solutions/curtains",
      "destination": "/curtains.html"
    },
    {
      "source": "/solutions/outdoor",
      "destination": "/outdoor.html"
    },
    {
      "source": "/projects",
      "destination": "/projects.html"
    },
    {
      "source": "/projects/villa-albinoni",
      "destination": "/villa-albinoni.html"
    },
    {
      "source": "/showrooms",
      "destination": "/showrooms.html"
    },
    {
      "source": "/professionals",
      "destination": "/professionals.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/showrooms/interiors",
      "destination": "/showroom-interiors.html"
    },
    {
      "source": "/showrooms/outdoor",
      "destination": "/showroom-outdoor.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
